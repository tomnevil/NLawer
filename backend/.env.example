# 复制为 .env 后按需修改。留空的 LLM 配置会自动降级为 MockProvider，零网络也能演示。

# ---- 服务 ----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ---- 数据库（默认 SQLite 零依赖）----
DATABASE_URL=sqlite+aiosqlite:///./storage/nlawer.db
DATABASE_URL_SYNC=sqlite:///./storage/nlawer.db

# ---- 生产：Postgres + pgvector ----
# 依赖：pip install -r requirements.txt -r requirements-postgres.txt
# 本地起库：docker compose up -d db
# 宿主端口需与 docker-compose.yml 映射一致（默认 5433，避免与本机 5432 冲突）
# DATABASE_URL=postgresql+asyncpg://nlawer:nlawer@localhost:5433/nlawer
# DATABASE_URL_SYNC=postgresql+psycopg2://nlawer:nlawer@localhost:5433/nlawer
# 向量后端（auto 会在 Postgres+pgvector 下自动启用 pgvector）
# VECTOR_BACKEND=auto

# ---- JWT ----
SECRET_KEY=change-me-nlawer-jwt-secret
ALGORITHM=HS256
# access 短时化（30 分钟）。refresh 由 HttpOnly Cookie 承载，7 天。
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ---- 认证 Cookie / CSRF ----
# refresh 令牌走 HttpOnly Cookie（JS 不可读，防 XSS 窃取）；
# 同时启用签名式双提交 CSRF 令牌。
# ⚠️ 生产环境 AUTH_COOKIE_SECURE 必须为 true，否则启动即失败（fail-fast）。
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# 需要 CSRF 双提交校验的路径前缀（逗号分隔）；都是「凭 Cookie 即可生效」的端点
CSRF_PROTECTED_PREFIXES=/api/v1/auth/refresh,/api/v1/auth/logout
CSRF_STRICT_ALL_WRITES=false

# ---- LLM / 模型路由（全部留空即走 MockProvider）----
# 低成本档：通用问答 / 常规文书
LLM_CHEAP_API_KEY=
LLM_CHEAP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CHEAP_MODEL=qwen-plus
# 高精度档：赔偿计算 / 合规判定 / 证据分析
LLM_STRONG_API_KEY=
LLM_STRONG_BASE_URL=https://api.deepseek.com
LLM_STRONG_MODEL=deepseek-chat
# 私有化档：敏感数据不出域
LLM_LOCAL_API_KEY=
LLM_LOCAL_BASE_URL=http://localhost:11434/v1
LLM_LOCAL_MODEL=qwen2.5:32b
# ---- 模型网关（CME Cloud tokenplan，OpenAI 兼容，推荐）----
# 一个 Key 覆盖网关全部可用模型；配置后三档统一走网关，按法务任务自动选模型。
# 可用模型见 config.LLM_GATEWAY_MODELS（已内置 qwen/qwen3.7-max、DeepSeek-V4-Flash、
# ZHIPU/GLM-5.1、minimax/MiniMax-M3、Kimi/Kimi-K2.6 等）。模型 ID 大小写敏感。
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://zhenze-huhehaote.cmecloud.cn/tokenplan/v1
# 可选：JSON 覆盖法务任务 -> 模型，如 {"qa":"MiniMax-M2.5","contract_review":"ZHIPU/GLM-5.2"}
LLM_TASK_MODEL=
# 向量检索开关（留空则只走 BM25）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# ---- 存储 ----
LOCAL_STORAGE_PATH=./storage/local

# ---- 多租户 ----
DEFAULT_TENANT_ID=platform
ALLOW_TENANT_FALLBACK=true

# ---- 计费 ----
# 超量工单单价（分）
WORK_ORDER_PRICE_CENTS=4900
WORK_ORDER_URGENT_SURCHARGE_CENTS=3000

# ---- 强制复核阈值 ----
# 标的额达到该值（元）即触发强制 L2 复核
FORCED_REVIEW_AMOUNT_THRESHOLD=500000

# ---- 审计 ----
AUDIT_ENABLED=true

# ---- 限流（默认开启，安全默认值）----
# 本地开发/单测如无需要可设为 false
RATE_LIMIT_ENABLED=true
# 认证档：同 IP 对单端点 60s 内最大请求数（防暴力破解）
RATE_LIMIT_LOGIN_MAX=20
# 上传档：更严，防存储滥用
RATE_LIMIT_UPLOAD_MAX=10
# 生成档：AI 重计算端点，防刷成本
RATE_LIMIT_GENERATE_MAX=15
RATE_LIMIT_WINDOW_SECONDS=60
# Redis 限流后端（多副本共享计数）。
# 留空 = 进程内计数：单副本正确；多副本下实际阈值 = 配置值 × 副本数。
# 多副本部署请务必配置，例如：redis://localhost:6379/0
REDIS_URL=

# ---- 异步任务 ----
# 并发消费者数量（同时运行的 AI 任务上限）
JOB_MAX_CONCURRENCY=4
JOB_MAX_RETRIES=3
JOB_RETRY_BASE_DELAY=2.0
# 队列最大长度（满时反压等待，任务已落库不会丢）
JOB_QUEUE_MAX_SIZE=500
# 僵尸任务判定：RUNNING 且超过该秒数无心跳 -> 回收重跑
JOB_STALE_TIMEOUT_SECONDS=300
# 僵尸任务巡检间隔（秒）
JOB_RECOVERY_INTERVAL_SECONDS=60
