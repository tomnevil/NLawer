# monorepo ???apps/* ?? packages/*?workspace:*??????????
# frontend/ ?????standalone ?????????????????
#
# ?????admin??
#   docker build -f frontend/Dockerfile --build-arg APP=admin \
#     --build-arg NEXT_PUBLIC_API_BASE=http://localhost:8000 \
#     -t nlaw-admin frontend/
#   docker run -p 3002:3000 nlaw-admin
#
# ???NEXT_PUBLIC_* ???????????**??**?
# NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS??????????????????
# ??? P1-1 ???????

FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /repo

# ????pnpm fetch ????????????? Invalidate ???
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
RUN pnpm fetch

# ????.dockerignore ??? node_modules / .next?
COPY . .
RUN pnpm install --frozen-lockfile --offline

ARG APP=admin
ARG NEXT_PUBLIC_API_BASE=http://localhost:8000
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
RUN pnpm -C apps/$APP build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# standalone ???server.js + ?????? node_modules?? monorepo ?????
COPY --from=builder /repo/apps/$APP/.next/standalone ./
COPY --from=builder /repo/apps/$APP/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
